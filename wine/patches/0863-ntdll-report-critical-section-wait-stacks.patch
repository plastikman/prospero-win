From: ps4-gladius <ps4-gladius@invalid>
Subject: [PATCH] ntdll: report stacks on critical section wait timeouts

The GTA IV menu-load run repeatedly has threads 0024 and 0090 blocked on
critical sections owned by each other. Dump the waiting thread's frame chain
when Wine reports a timeout, so the next capture identifies the call paths.

--- a/dlls/ntdll/sync.c
+++ b/dlls/ntdll/sync.c
@@ -318,6 +318,14 @@
 
         ERR( "section %p %s wait timed out in thread %04lx, blocked by %04lx, retrying (%u sec)\n",
              crit, debugstr_a(crit_section_get_name(crit)), GetCurrentThreadId(), HandleToULong(crit->OwningThread), timeout );
+        {
+            void *frames[12];
+            ULONG frame_count = RtlCaptureStackBackTrace( 0, ARRAY_SIZE(frames), frames, NULL );
+            ULONG i;
+
+            for (i = 0; i < frame_count; i++)
+                ERR( "section %p wait stack[%lu]=%p\n", crit, i, frames[i] );
+        }
     }
     if (crit_section_has_debuginfo( crit )) crit->DebugInfo->ContentionCount++;
     return STATUS_SUCCESS;
