From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ps4-gladius <ps4-gladius@invalid>
Date: Thu, 8 Oct 2026 09:40:00 +0000
Subject: [PATCH] server: this console cannot set non-blocking mode.

0741 named the failure:

    init_thread 0024 FAILED: O_NONBLOCK on the reply pipe refused
                     (reply_fd=33 wait_fd=35 errno=13) in flight:

errno 13 is EACCES. fcntl( fd, F_SETFL, O_NONBLOCK ) is refused here, and so is
ioctl FIONBIO, the ioctl FreeBSD has always carried for the same job -- both
measured on a pipe. This console's fcntl is selectively implemented; F_DUPFD and
F_GETFD are refused as well. Nothing sets the flag, so descriptors stay
blocking, and the question is no longer how to ask but what depends on it.

The failure was fatal in three places and ignored in six. It need not be fatal
anywhere: every caller in the server writes one small reply to a client already
waiting for it, which does not block in practice. One helper answers for all
nine sites, says once through klog that the mode is unavailable, and reports
success so the thread keeps its reply pipe.

The one caller that genuinely needs the flag is the main loop's drain of its
wake pipe, and patch 0771 gives it poll() instead -- the unguarded drain loop
would wait forever for a byte nobody sends.

The empty in-flight list in that diagnostic is not a second fault: both
descriptors were found, and thread_get_inflight_fd clears the slot it answers
from, so it confirms the handover in 0737 and 0738 works.
---
diff --git a/server/fd.c b/server/fd.c
--- a/server/fd.c
+++ b/server/fd.c
@@ -25,6 +25,9 @@
 #include <dirent.h>
 #include <errno.h>
 #include <fcntl.h>
+#ifdef __PROSPERO__
+#include <sys/ioctl.h>
+#endif
 #include <limits.h>
 #include <signal.h>
 #include <stdarg.h>
@@ -2473,6 +2476,43 @@ int is_fd_overlapped( struct fd *fd )
 }
 
 /* retrieve the unix fd for an object */
+/* put a descriptor in non-blocking mode, if this platform can.
+ *
+ * ⚠ PS4 cannot. fcntl( fd, F_SETFL, O_NONBLOCK ) is refused with EACCES,
+ * measured on the reply pipe in init_thread, and so is ioctl FIONBIO, the ioctl
+ * FreeBSD has always carried for the same job. This console's fcntl is
+ * selectively implemented -- F_DUPFD and F_GETFD are refused as well -- and
+ * nothing else sets the flag, so descriptors here simply stay blocking.
+ *
+ * Report that once and return success. Every caller in the server treats
+ * non-blocking mode as an optimisation: they write one small reply to a client
+ * that is already waiting for it, so the write does not block in practice. The
+ * exception is the main loop's drain of its wake pipe, which cannot spin on
+ * read() without a non-blocking descriptor and asks poll() what is there
+ * instead -- see inprocess_wake_poll_event. */
+int pw_set_nonblocking( int fd )
+{
+#ifdef __PROSPERO__
+    static int reported;
+    int on = 1;
+
+    if (!ioctl( fd, FIONBIO, &on )) return 0;
+    if (!fcntl( fd, F_SETFL, O_NONBLOCK )) return 0;
+    if (!reported++)
+    {
+        extern int sceKernelDebugOutText( int channel, const char *text );
+        char line[160];
+        snprintf( line, sizeof(line),
+                  "wineserver: this console cannot set non-blocking mode (errno %d); "
+                  "descriptors stay blocking\n", errno );
+        sceKernelDebugOutText( 0, line );
+    }
+    return 0;
+#else
+    return fcntl( fd, F_SETFL, O_NONBLOCK );
+#endif
+}
+
 int get_unix_fd( struct fd *fd )
 {
 #ifdef PS5_PARK_DIRECTORIES
diff --git a/server/file.h b/server/file.h
--- a/server/file.h
+++ b/server/file.h
@@ -300,4 +300,7 @@ static inline int async_queued( struct async_queue *queue )
 #define FILE_MAPPING_WRITE  0x40000000  /* set for writable shared mappings */
 #define FILE_MAPPING_ACCESS 0x20000000  /* set for all mappings */
 
+/* put a descriptor in non-blocking mode (fcntl is refused on PS4) */
+extern int pw_set_nonblocking( int fd );
+
 #endif  /* __WINE_SERVER_FILE_H */
diff --git a/server/process.c b/server/process.c
--- a/server/process.c
+++ b/server/process.c
@@ -1131,7 +1131,7 @@ DECL_HANDLER(new_process)
     }
     if (params.root) release_object( params.root );  /* unused */
 
-    if (fcntl( socket_fd, F_SETFL, O_NONBLOCK ) == -1)
+    if (pw_set_nonblocking( socket_fd ) == -1)
     {
         set_error( STATUS_INVALID_HANDLE );
         close( socket_fd );
diff --git a/server/request.c b/server/request.c
--- a/server/request.c
+++ b/server/request.c
@@ -1086,7 +1086,7 @@ static void master_socket_poll_event( struct fd *fd, int event )
         int client = accept( get_unix_fd( master_socket->fd ), (struct sockaddr *) &dummy, &len );
 #endif
         if (client == -1) return;
-        fcntl( client, F_SETFL, O_NONBLOCK );
+        pw_set_nonblocking( client );
         if ((process = create_process( client, NULL, 0, NULL, NULL, NULL, 0, NULL )))
         {
             struct thread *thread = create_thread( -1, process, NULL );
diff --git a/server/sock.c b/server/sock.c
--- a/server/sock.c
+++ b/server/sock.c
@@ -1964,7 +1964,7 @@ static int init_socket( struct sock *sock, int family, int type, int protocol )
         else set_win32_error( sock_get_error( errno ));
         return -1;
     }
-    fcntl(sockfd, F_SETFL, O_NONBLOCK); /* make socket nonblocking */
+    pw_set_nonblocking( sockfd ); /* make socket nonblocking */
 
     if (family == WS_AF_IPX && protocol >= WS_NSPROTO_IPX && protocol <= WS_NSPROTO_IPX + 255)
     {
@@ -2060,7 +2060,7 @@ static int accept_new_fd( struct sock *sock )
     socklen_t slen = sizeof(saddr);
     int acceptfd = accept( get_unix_fd(sock->fd), &saddr, &slen );
     if (acceptfd != -1)
-        fcntl( acceptfd, F_SETFL, O_NONBLOCK );
+        pw_set_nonblocking( acceptfd );
     else
         set_error( sock_get_ntstatus( errno ));
     return acceptfd;
@@ -3800,7 +3800,7 @@ static void ifchange_poll_event( struct fd *fd, int event )
         set_error( sock_get_ntstatus( errno ));
         return NULL;
     }
-    fcntl( unix_fd, F_SETFL, O_NONBLOCK ); /* make socket nonblocking */
+    pw_set_nonblocking( unix_fd ); /* make socket nonblocking */
     memset( &addr, 0, sizeof(addr) );
     addr.nl_family = AF_NETLINK;
     addr.nl_groups = RTMGRP_IPV4_IFADDR;
diff --git a/server/thread.c b/server/thread.c
--- a/server/thread.c
+++ b/server/thread.c
@@ -1844,7 +1844,7 @@ DECL_HANDLER(new_thread)
             goto done;
         }
     }
-    else if (request_fd == -1 || fcntl( request_fd, F_SETFL, O_NONBLOCK ) == -1)
+    else if (request_fd == -1 || pw_set_nonblocking( request_fd ) == -1)
     {
         if (request_fd != -1) close( request_fd );
         set_error( STATUS_INVALID_HANDLE );
@@ -1904,7 +1904,7 @@ static int init_thread( struct thread *thread, int reply_fd, int wait_fd )
         goto error;
     }
 
-    if (fcntl( reply_fd, F_SETFL, O_NONBLOCK ) == -1) goto error;
+    if (pw_set_nonblocking( reply_fd ) == -1) goto error;
 
     thread->reply_fd = create_anonymous_fd( &thread_fd_ops, reply_fd, &thread->obj, 0 );
     thread->wait_fd  = create_anonymous_fd( &thread_fd_ops, wait_fd, &thread->obj, 0 );
-- 
