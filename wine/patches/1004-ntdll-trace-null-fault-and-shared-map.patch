From: Codex <codex@localhost>
Subject: ntdll: trace null-range guest faults and shared mapping failures

Include near-null guest faults and query RBX alongside the existing fault
and RDI mapping details. Preserve the shared-writable mmap failure geometry
and errno when the PS4 mapping path rejects the request.

---
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 3d4f65081b..4c15eb7018 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2840,38 +2840,44 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
             int32_t protection, memory_type;
             uint8_t flags;
             char name[32];
-        } before_fault, before_object, after_fault;
+        } before_fault, before_rbx, before_object, after_fault;
         extern int sceKernelVirtualQuery( const void *, int, void *, size_t );
         extern int sceKernelDebugOutText( int, const char * );
         static unsigned int guest_fault_trace_count;
         unsigned int guest_fault_n = 0;
-        int q_fault = -1, q_object = -1, q_after = -1, hook_result;
+        int q_fault = -1, q_rbx = -1, q_object = -1, q_after = -1, hook_result;
 
         /* Bound this targeted Fallout 3 guest-data-fault trace. */
-        if (siginfo && (uintptr_t)siginfo->si_addr >= 0x00400000 &&
-            (uintptr_t)siginfo->si_addr < 0x08000000 && !(ERROR_sig(sigcontext) & 0x10))
+        if (siginfo && (uintptr_t)siginfo->si_addr < 0x08000000 &&
+            !(ERROR_sig(sigcontext) & 0x10))
         {
             guest_fault_n = __atomic_add_fetch( &guest_fault_trace_count, 1, __ATOMIC_RELAXED );
             if (guest_fault_n <= 12)
             {
                 char line[512];
                 memset( &before_fault, 0, sizeof(before_fault) );
+                memset( &before_rbx, 0, sizeof(before_rbx) );
                 memset( &before_object, 0, sizeof(before_object) );
                 q_fault = sceKernelVirtualQuery( siginfo->si_addr, 1, &before_fault, sizeof(before_fault) );
+                q_rbx = sceKernelVirtualQuery( (void *)(uintptr_t)RBX_sig(sigcontext), 1,
+                                               &before_rbx, sizeof(before_rbx) );
                 q_object = sceKernelVirtualQuery( (void *)(uintptr_t)RDI_sig(sigcontext), 1,
                                                   &before_object, sizeof(before_object) );
                 before_fault.name[sizeof(before_fault.name) - 1] = 0;
+                before_rbx.name[sizeof(before_rbx.name) - 1] = 0;
                 before_object.name[sizeof(before_object.name) - 1] = 0;
                 snprintf( line, sizeof(line),
-                          "ntdll ps4-guest-fault-map n=%u sig=%d code=%d addr=%p rip=%llx rsp=%llx rax=%llx rbx=%llx rsi=%llx rdi=%llx err=%llx qaddr=%d range=%p-%p prot=%x type=%x flags=%x name=%s qobj=%d obj_range=%p-%p obj_prot=%x obj_name=%s\n",
+                          "ntdll ps4-guest-fault-map n=%u sig=%d code=%d addr=%p rip=%llx rsp=%llx rax=%llx rbx=%llx rsi=%llx rdi=%llx err=%llx qaddr=%d range=%p-%p prot=%x type=%x flags=%x name=%s qrbx=%d rbx_range=%p-%p rbx_prot=%x rbx_name=%s qobj=%d obj_range=%p-%p obj_prot=%x obj_name=%s\n",
                           guest_fault_n, signal, siginfo->si_code, siginfo->si_addr,
                           (unsigned long long)RIP_sig(sigcontext), (unsigned long long)RSP_sig(sigcontext),
                           (unsigned long long)RAX_sig(sigcontext), (unsigned long long)RBX_sig(sigcontext),
                           (unsigned long long)RSI_sig(sigcontext), (unsigned long long)RDI_sig(sigcontext),
                           (unsigned long long)ERROR_sig(sigcontext), q_fault, before_fault.start,
                           before_fault.end, before_fault.protection, before_fault.memory_type,
-                          before_fault.flags, before_fault.name, q_object, before_object.start,
-                          before_object.end, before_object.protection, before_object.name );
+                          before_fault.flags, before_fault.name, q_rbx, before_rbx.start,
+                          before_rbx.end, before_rbx.protection, before_rbx.name,
+                          q_object, before_object.start, before_object.end,
+                          before_object.protection, before_object.name );
                 sceKernelDebugOutText( 0, line );
             }
         }
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 4ea82ce80b..53f546ad2e 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2863,6 +2863,7 @@ static NTSTATUS map_file_into_view( struct file_view *view, int fd, size_t start
     char *map_addr, *host_addr;
     size_t map_size, host_size;
     int prot = PROT_READ | PROT_WRITE;
+    int mmap_attempted = 0, mmap_errno = 0;
     unsigned int flags = MAP_FIXED;
 
     assert( start < view->size );
@@ -2893,8 +2894,10 @@ static NTSTATUS map_file_into_view( struct file_view *view, int fd, size_t start
        and if alignment is correct */
     if ((!removable || (flags & MAP_SHARED)) && host_addr == map_addr && host_size == map_size)
     {
+        mmap_attempted = 1;
         if (mmap( host_addr, host_size, prot, flags, fd, offset ) != MAP_FAILED)
             return STATUS_SUCCESS;
+        mmap_errno = errno;
 
         switch (errno)
         {
@@ -2921,6 +2924,12 @@ static NTSTATUS map_file_into_view( struct file_view *view, int fd, size_t start
 
     if (vprot & VPROT_WRITE)
     {
+        ERR( "PS4_MAP_FILE_SHARED_FAIL view=%p start=%lx size=%lx map=%p map_size=%lx host=%p host_size=%lx offset=%llx fd=%d prot=%#x flags=%#x vprot=%#x removable=%u page_mask=%lx host_page_mask=%lx mmap_attempted=%d errno=%d (%s)\n",
+             view->base, (unsigned long)start, (unsigned long)size, map_addr,
+             (unsigned long)map_size, host_addr, (unsigned long)host_size,
+             (unsigned long long)offset, fd, prot, flags, vprot, removable,
+             (unsigned long)page_mask, (unsigned long)host_page_mask,
+             mmap_attempted, mmap_errno, mmap_errno ? strerror(mmap_errno) : "not attempted" );
         ERR( "unaligned shared mapping %p-%p not supported\n", map_addr, map_addr + map_size );
         return STATUS_INVALID_PARAMETER;
     }
