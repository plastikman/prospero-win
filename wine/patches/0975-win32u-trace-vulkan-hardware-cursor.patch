From: Codex <codex@localhost>
Subject: win32u: Trace PS5 Vulkan hardware cursor handoff

Report the first cursor state passed from Wine to VideoOut, changes in
visibility, and changes in the return status. This distinguishes a game that
keeps its Windows cursor hidden from a failed VideoOut hardware-cursor call
without logging once per presented frame.

---
diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
index 9e44e099ca7..7b98528dce9 100644
--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -770,6 +770,8 @@ void ps5drv_vulkan_cursor( void *vulkan_handle )
 {
     static int (*show)( const UINT32 *, UINT, UINT, INT, INT, UINT, UINT );
     static BOOL looked;
+    static BOOL reported, last_visible;
+    static int last_result;
 
     if (!looked)
     {
@@ -778,8 +780,21 @@ void ps5drv_vulkan_cursor( void *vulkan_handle )
     }
     if (!show) return;
     pthread_mutex_lock( &screen_lock );
-    show( cursor_width && cursor_height ? cursor_image : NULL, cursor_width, cursor_height,
-          cursor.x - cursor_hotspot.x, cursor.y - cursor_hotspot.y, screen_width, screen_height );
+    {
+        BOOL visible = cursor_image && cursor_width && cursor_height;
+        int result = show( visible ? cursor_image : NULL, cursor_width, cursor_height,
+                           cursor.x - cursor_hotspot.x, cursor.y - cursor_hotspot.y,
+                           screen_width, screen_height );
+
+        if (!reported || visible != last_visible || result != last_result)
+            ERR( "PW_VK_CURSOR visible=%u image=%p size=%ux%u pos=%d,%d desktop=%ux%u result=%d\n",
+                 visible, cursor_image, cursor_width, cursor_height,
+                 cursor.x - cursor_hotspot.x, cursor.y - cursor_hotspot.y,
+                 screen_width, screen_height, result );
+        reported = TRUE;
+        last_visible = visible;
+        last_result = result;
+    }
     pthread_mutex_unlock( &screen_lock );
 }
 #endif
--
