+#include <stdlib.h>
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
 
-HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+/* ⚠ Objects that exist, rather than E_NOTIMPL and untouched out pointers.
+ *
+ * DirectComposition is how a modern Windows program gets its swapchain onto
+ * the screen without owning a window: it makes a device, a target for its
+ * HWND, and a visual whose content is the swapchain, then roots the visual in
+ * the target and commits. GTA IV reaches this port through 1911.dll and does
+ * exactly that, and the stub answered every call with E_NOTIMPL and nothing
+ * written where a pointer was meant to go.
+ *
+ * It cost two separate failures. First the device itself: the loader does not
+ * check the HRESULT and read a field at +0x2c off the NULL it was left with --
+ *
+ *     fixme:dcomp:DCompositionCreateDevice ...
+ *     err:wow:raise_guest_exception guest exception 0xc0000005 ... address 0x2c
+ *
+ * -- which had been read as a DRM check for most of a day. Then, once a device
+ * existed and the composition swapchain had been created and filled in,
+ * CreateTargetForHwnd stopped it dead with the game idle at 0% and the screen
+ * black, the display already handed over to Vulkan.
+ *
+ * ⚠ And the first version of this file had a bug that i386 would eventually
+ * have been punished for: every method was declared WINAPI taking only iface,
+ * whatever its real signature, and cast into the vtable. stdcall is
+ * callee-pops, so CreateTargetForHwnd popped four bytes where the caller had
+ * pushed sixteen. The methods below carry their real signatures and the
+ * vtables are the generated typed ones, so the compiler checks every slot.
+ *
+ * What this implements is the shape of the thing, not the thing. There is no
+ * compositor on this console and no need for one: the swapchain presents
+ * itself straight to the scanout through RADV's WSI. So a target accepts a
+ * root, a visual accepts content and every placement call succeeds without
+ * doing anything, and Commit returns S_OK. Everything with no bearing on
+ * getting a swapchain shown still answers E_NOTIMPL -- surfaces, transforms,
+ * effects, clips, animations -- because a caller is better told no than handed
+ * an object that silently does nothing. */
+
+struct dcomp_visual
+{
+    IDCompositionVisual IDCompositionVisual_iface;
+    LONG refcount;
+    IUnknown *content;
+};
+
+struct dcomp_target
+{
+    IDCompositionTarget IDCompositionTarget_iface;
+    LONG refcount;
+    IDCompositionVisual *root;
+};
+
+struct dcomp_device
+{
+    IDCompositionDevice IDCompositionDevice_iface;
+    LONG refcount;
+};
+
+/* ---- visual ---------------------------------------------------------- */
+
+static struct dcomp_visual *impl_from_IDCompositionVisual( IDCompositionVisual *iface )
+{
+    return CONTAINING_RECORD( iface, struct dcomp_visual, IDCompositionVisual_iface );
+}
+
+static ULONG WINAPI visual_AddRef( IDCompositionVisual *iface )
+{
+    return InterlockedIncrement( &impl_from_IDCompositionVisual( iface )->refcount );
+}
+
+static ULONG WINAPI visual_Release( IDCompositionVisual *iface )
+{
+    struct dcomp_visual *visual = impl_from_IDCompositionVisual( iface );
+    ULONG refcount = InterlockedDecrement( &visual->refcount );
+
+    if (!refcount)
+    {
+        if (visual->content) visual->content->lpVtbl->Release( visual->content );
+        free( visual );
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI visual_QueryInterface( IDCompositionVisual *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IDCompositionVisual ) || IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        visual_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+    WARN( "%s not implemented.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* The placement calls. Nothing composes here, so a visual is where it is told
+ * it is and the answer is yes. */
+static HRESULT WINAPI visual_SetOffsetXAnimation( IDCompositionVisual *iface, IDCompositionAnimation *animation )
+{
+    TRACE( "iface %p, animation %p.\n", iface, animation );
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_SetOffsetX( IDCompositionVisual *iface, float offset_x )
+{
+    TRACE( "iface %p, offset_x %f.\n", iface, offset_x );
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_SetOffsetYAnimation( IDCompositionVisual *iface, IDCompositionAnimation *animation )
