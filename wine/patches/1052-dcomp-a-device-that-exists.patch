+    return S_OK;
+}
+
+static HRESULT WINAPI visual_SetClipObject( IDCompositionVisual *iface, IDCompositionClip *clip )
+{
+    TRACE( "iface %p, clip %p.\n", iface, clip );
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_SetClip( IDCompositionVisual *iface, const D2D_RECT_F *rect )
