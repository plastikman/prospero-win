From: Codex <codex@localhost>
Subject: ntdll: log PS4 syscall-fault instruction bytes

For syscall faults, record the saved error/access data and safely read a
bounded instruction window through Wine's uninterrupted-memory helper.
This avoids dereferencing an arbitrary faulting IP in the signal path.

---
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index da454408f6..3ed530530f 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2445,6 +2445,18 @@ static BOOL handle_syscall_fault( struct thread_data *data, ucontext_t *sigconte
     TRACE_(seh)( " r12=%016lx r13=%016lx r14=%016lx r15=%016lx\n",
                  context->R12, context->R13, context->R14, context->R15 );
 #ifdef __PROSPERO__
+    if (context->Rip)
+    {
+        BYTE instruction[8] = {0};
+        SIZE_T length = virtual_uninterrupted_read_memory( (void *)(ULONG_PTR)context->Rip,
+                                                           instruction, sizeof(instruction) );
+        if (length >= sizeof(instruction))
+            ERR_(seh)( "fault instruction err=%llx params=%u p0=%016lx p1=%016lx bytes=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+                       (unsigned long long)ERROR_sig(sigcontext), rec->NumberParameters,
+                       rec->ExceptionInformation[0], rec->ExceptionInformation[1],
+                       instruction[0], instruction[1], instruction[2], instruction[3],
+                       instruction[4], instruction[5], instruction[6], instruction[7] );
+    }
     {
         /* Name where the syscall faulted (or, for a call through a NULL
          * pointer, its caller). The syscall then fails with the exception
