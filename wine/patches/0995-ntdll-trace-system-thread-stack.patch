From: Codex <codex@localhost>
Subject: ntdll: trace PS4 system-thread stack at startup

Log the supplied Wine system-thread stack and callback at startup. The older
stack-underflow frame-chain hunk depended on a diagnostic block absent from
the rebased signal path; retain the startup diagnostic, while exception
context and TEB bounds remain covered by patches 0991 and 0994.

---
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 4658522376..606bdf83d6 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -2370,6 +2370,16 @@ void server_init_thread( struct thread_data *data )
 
     data->pthread_id = pthread_self();
     pthread_setspecific( thread_data_key, data );
+#ifdef __PROSPERO__
+    if (!data->teb)
+    {
+        ULONG_PTR rsp;
+        __asm__ volatile( "movq %%rsp,%0" : "=r" (rsp) );
+        ERR( "PW_SYSTEM_THREAD_STACK tid=%04x data=%p pthread=%p start=%p param=%p rsp=%p stack=%p-%p\n",
+             (unsigned)data->tid, data, (void *)(ULONG_PTR)data->pthread_id, data->start, data->param,
+             (void *)rsp, get_kernel_stack(data), (char *)get_kernel_stack(data) + kernel_stack_size );
+    }
+#endif
     if (data->ps5_spawn_us && ps5_now_us() - data->ps5_spawn_us > 100000)
         fprintf( stderr, "wine-ps5: slow thread start ms=%llu\n", (ps5_now_us() - data->ps5_spawn_us) / 1000 );
 
