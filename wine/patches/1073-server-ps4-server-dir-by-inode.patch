From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Subject: [PATCH] server: Name the PS4 server directory by inode alone.

st_dev of the prefix directory is not stable on the PS4, so a server
directory named server-<dev>-<ino> changes between calls and the identity
check after chdir fails. Name it server-<ino> there (a prefix cannot span
devices), keep failing when the inode after chdir differs, and only log a
differing st_dev, now with both stat records in full (mode, uid, gid, size)
instead of 0741's one-line note. Other platforms are unchanged.

This change shipped in the console tree (GLDS10043 01.41 = v0.0.1, 01.43 =
v0.0.2) but was never in the patch series; it is recovered here verbatim from
that tree.
---
diff --git a/server/request.c b/server/request.c
--- a/server/request.c
+++ b/server/request.c
@@ -1224,8 +1224,14 @@ static char *create_server_dir( int force )
 
     /* now create the server directory */
 
+#ifdef __PROSPERO__
+    /* st_dev is unstable on PS4; the prefix cannot span devices. */
+    if (asprintf( &server_dir, "%s/server-%llx", base_dir,
+                  (unsigned long long)st.st_ino ) == -1)
+#else
     if (asprintf( &server_dir, "%s/server-%llx-%llx", base_dir,
                   (unsigned long long)st.st_dev, (unsigned long long)st.st_ino ) == -1)
+#endif
         fatal_error( "out of memory\n" );
 
     create_dir( server_dir, &st );
@@ -1236,21 +1242,29 @@ static char *create_server_dir( int force )
         fatal_error( "open %s: %s\n", server_dir, strerror( errno ));
     if (fstat( server_dir_fd, &st2 ) == -1)
         fatal_error( "stat %s: %s\n", server_dir, strerror( errno ));
-    if (st.st_dev != st2.st_dev || st.st_ino != st2.st_ino)
-    {
 #ifdef __PROSPERO__
+    if (st.st_ino != st2.st_ino)
+        fatal_error( "chdir did not end up in %s\n", server_dir );
+    if (st.st_dev != st2.st_dev)
+    {
         extern int sceKernelDebugOutText( int channel, const char *text );
-        char line[192];
+        char line[512];
 
         snprintf( line, sizeof(line),
-                  "wineserver: server-dir identity differs dev=%llx/%llx ino=%llx/%llx\n",
-                  (unsigned long long)st.st_dev, (unsigned long long)st2.st_dev,
-                  (unsigned long long)st.st_ino, (unsigned long long)st2.st_ino );
+                  "wineserver: server-dir stat path dev=%llx ino=%llx mode=%o uid=%u gid=%u size=%lld; cwd dev=%llx ino=%llx mode=%o uid=%u gid=%u size=%lld\n",
+                  (unsigned long long)st.st_dev, (unsigned long long)st.st_ino,
+                  (unsigned int)st.st_mode,
+                  (unsigned int)st.st_uid, (unsigned int)st.st_gid,
+                  (long long)st.st_size, (unsigned long long)st2.st_dev,
+                  (unsigned long long)st2.st_ino, (unsigned int)st2.st_mode,
+                  (unsigned int)st2.st_uid, (unsigned int)st2.st_gid,
+                  (long long)st2.st_size );
         sceKernelDebugOutText( 0, line );
+    }
 #else
+    if (st.st_dev != st2.st_dev || st.st_ino != st2.st_ino)
         fatal_error( "chdir did not end up in %s\n", server_dir );
 #endif
-    }
 
     free( base_dir );
     free( config_dir );
