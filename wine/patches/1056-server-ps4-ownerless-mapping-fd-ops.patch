From: Claude <noreply@anthropic.com>
Subject: [PATCH] server: give an ownerless mapping fd the mapping ops (archive 0871).

Archive 0871 unchanged (applies with offsets). Defensive: get_handle_fd
dereferences fd->fd_ops without a check, so an ownerless mapping fd would be
a server-fatal NULL call if the reopen fallback in mapping_init ever runs.
---
diff --git a/server/fd.c b/server/fd.c
index 01e513eba1..03cfc24311 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -2027,6 +2027,14 @@ struct fd *get_fd_object_for_mapping( struct fd *fd, unsigned int access, unsign
     return NULL;
 }
 
+#ifdef __PROSPERO__
+/* whether an fd has had its user ops installed yet; see mapping_init */
+int fd_has_user_ops( struct fd *fd )
+{
+    return fd->fd_ops != NULL;
+}
+#endif
+
 /* sets the user of an fd that previously had no user */
 void set_fd_user( struct fd *fd, const struct fd_ops *user_ops, struct object *user )
 {
diff --git a/server/file.h b/server/file.h
index 0e6a768cb0..34ec18ae97 100644
--- a/server/file.h
+++ b/server/file.h
@@ -94,6 +94,9 @@ extern int ps5_release_image_view_fd( struct fd *fd, unsigned int view_refs );
 extern int ps5_is_image_view_fd_released( struct fd *fd );
 extern void *get_fd_user( struct fd *fd );
 extern void set_fd_user( struct fd *fd, const struct fd_ops *ops, struct object *user );
+#ifdef __PROSPERO__
+extern int fd_has_user_ops( struct fd *fd );
+#endif
 extern unsigned int get_fd_options( struct fd *fd );
 extern unsigned int get_fd_comp_flags( struct fd *fd );
 extern int is_fd_overlapped( struct fd *fd );
diff --git a/server/mapping.c b/server/mapping.c
index 873f6e5431..12bddfa1e0 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1176,6 +1176,30 @@ static bool mapping_init( struct object *obj, const void *init_data )
 #endif
         }
         if (!mapping->fd) return false;
+#ifdef __PROSPERO__
+        /* ⚠ The fd may still have no user, whichever of the two paths above
+         * produced it. An fd the server opened for itself never passes through
+         * set_fd_user: load_intl_file() returns l_intl.nls straight out of
+         * open_fd(), because upstream only ever reaches that fd through
+         * get_unix_fd() and pread(). Upstream is then safe by construction --
+         * dup_fd_object() builds a *new* fd for the mapping and the line above
+         * gives it mapping_fd_ops. Neither of the paths this console is left
+         * with builds anything: get_fd_object_for_mapping() returns a matching
+         * fd from the inode's open list, and the grab below (no descriptor here
+         * can be duplicated) returns data->fd itself -- in both cases the
+         * original, with whatever user it had, which for the NLS file is none.
+         *
+         * A mapping is reachable by handle, and REQ_get_handle_fd calls
+         * fd->fd_ops->get_fd_type() with no NULL check, so the ownerless fd
+         * killed the server the moment a client asked for it -- a fault at
+         * address 0x10, get_fd_type's offset in struct fd_ops, as GTA IV's
+         * 32-bit ntdll opened \NLS\NlsSectionUnicode during locale init.
+         *
+         * Only fill a vacancy: an fd that already belongs to a file or a
+         * socket keeps its own ops, and set_fd_user() asserts on a second
+         * call. */
+        if (!fd_has_user_ops( mapping->fd )) set_fd_user( mapping->fd, &mapping_fd_ops, NULL );
+#endif
 
         if ((unix_fd = get_unix_fd( mapping->fd )) == -1) goto error;
         if (fstat( unix_fd, &st ) == -1)
