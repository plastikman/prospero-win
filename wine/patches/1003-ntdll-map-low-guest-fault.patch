From: Codex <codex@localhost>
Subject: ntdll: map low guest addresses on native faults

Extend Fallout 3 fault mapping diagnostics to the lower 32-bit game address
range and query the guest object pointer in RDI alongside the fault address.

---
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index d4446af595..3d4f65081b 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2840,38 +2840,38 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
             int32_t protection, memory_type;
             uint8_t flags;
             char name[32];
-        } before_fault, before_base, after_fault;
+        } before_fault, before_object, after_fault;
         extern int sceKernelVirtualQuery( const void *, int, void *, size_t );
         extern int sceKernelDebugOutText( int, const char * );
         static unsigned int guest_fault_trace_count;
         unsigned int guest_fault_n = 0;
-        int q_fault = -1, q_base = -1, q_after = -1, hook_result;
+        int q_fault = -1, q_object = -1, q_after = -1, hook_result;
 
         /* Bound this targeted Fallout 3 guest-data-fault trace. */
-        if (siginfo && (uintptr_t)siginfo->si_addr >= 0x06000000 &&
+        if (siginfo && (uintptr_t)siginfo->si_addr >= 0x00400000 &&
             (uintptr_t)siginfo->si_addr < 0x08000000 && !(ERROR_sig(sigcontext) & 0x10))
         {
             guest_fault_n = __atomic_add_fetch( &guest_fault_trace_count, 1, __ATOMIC_RELAXED );
             if (guest_fault_n <= 12)
             {
-                char line[384];
+                char line[512];
                 memset( &before_fault, 0, sizeof(before_fault) );
-                memset( &before_base, 0, sizeof(before_base) );
+                memset( &before_object, 0, sizeof(before_object) );
                 q_fault = sceKernelVirtualQuery( siginfo->si_addr, 1, &before_fault, sizeof(before_fault) );
-                q_base = sceKernelVirtualQuery( (void *)(uintptr_t)RBX_sig(sigcontext), 1,
-                                                &before_base, sizeof(before_base) );
+                q_object = sceKernelVirtualQuery( (void *)(uintptr_t)RDI_sig(sigcontext), 1,
+                                                  &before_object, sizeof(before_object) );
                 before_fault.name[sizeof(before_fault.name) - 1] = 0;
-                before_base.name[sizeof(before_base.name) - 1] = 0;
+                before_object.name[sizeof(before_object.name) - 1] = 0;
                 snprintf( line, sizeof(line),
-                          "ntdll ps4-guest-fault-map n=%u sig=%d code=%d addr=%p rip=%llx rsp=%llx rax=%llx rbx=%llx rsi=%llx rdi=%llx err=%llx qaddr=%d range=%p-%p prot=%x type=%x flags=%x name=%s qbase=%d base_range=%p-%p base_prot=%x base_name=%s\n",
+                          "ntdll ps4-guest-fault-map n=%u sig=%d code=%d addr=%p rip=%llx rsp=%llx rax=%llx rbx=%llx rsi=%llx rdi=%llx err=%llx qaddr=%d range=%p-%p prot=%x type=%x flags=%x name=%s qobj=%d obj_range=%p-%p obj_prot=%x obj_name=%s\n",
                           guest_fault_n, signal, siginfo->si_code, siginfo->si_addr,
                           (unsigned long long)RIP_sig(sigcontext), (unsigned long long)RSP_sig(sigcontext),
                           (unsigned long long)RAX_sig(sigcontext), (unsigned long long)RBX_sig(sigcontext),
                           (unsigned long long)RSI_sig(sigcontext), (unsigned long long)RDI_sig(sigcontext),
                           (unsigned long long)ERROR_sig(sigcontext), q_fault, before_fault.start,
                           before_fault.end, before_fault.protection, before_fault.memory_type,
-                          before_fault.flags, before_fault.name, q_base, before_base.start,
-                          before_base.end, before_base.protection, before_base.name );
+                          before_fault.flags, before_fault.name, q_object, before_object.start,
+                          before_object.end, before_object.protection, before_object.name );
                 sceKernelDebugOutText( 0, line );
             }
         }
