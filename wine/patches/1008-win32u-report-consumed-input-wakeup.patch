From: plastikman <plastikman@users.noreply.github.com>
Subject: win32u: report a consumed input wake as handled

Track whether the shared input wake pipe actually had bytes to consume, and
report that wake even if another GUI thread already drained its queued event.

---
diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
index 60d63cfbec..2a1849054e 100644
--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -595,7 +595,7 @@ static BOOL ps5_ProcessEvents( DWORD mask )
     struct ps5_input event;
     HWND hwnd = NtUserGetForegroundWindow();
     UINT processed = 0;
-    BOOL polled = FALSE;
+    BOOL wakeup = FALSE;
 
     if (!next_input) return FALSE;
     if (!hwnd && (hwnd = last_shown_window()))
@@ -614,11 +614,13 @@ static BOOL ps5_ProcessEvents( DWORD mask )
 #ifdef __PROSPERO__
             struct pollfd wake = { fd, POLLIN, 0 };
             while (poll( &wake, 1, 0 ) > 0 && (wake.revents & POLLIN))
+            {
                 if (read( fd, buffer, sizeof(buffer) ) <= 0) break;
+                wakeup = TRUE;
+            }
 #else
-            while (read( fd, buffer, sizeof(buffer) ) > 0) {}
+            while (read( fd, buffer, sizeof(buffer) ) > 0) wakeup = TRUE;
 #endif
-            polled = TRUE;
         }
     }
     while (processed < PS5_INPUT_BATCH && next_input( &event ))
@@ -654,7 +656,9 @@ static BOOL ps5_ProcessEvents( DWORD mask )
      * neither clears its QS_DRIVER nor re-arms the fd: a zero-timeout
      * message wait (DirectInput's GetDeviceState) then spins until the next
      * input. A byte still in the pipe makes the re-armed fd fire again. */
-    return processed != 0 || polled;
+    /* A thread can consume the shared wake pipe after another GUI thread
+     * already took the queued input. Report that wake as handled too. */
+    return processed != 0 || wakeup;
 }
 
 /***********************************************************************
