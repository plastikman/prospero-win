From: plastikman <plastikman@users.noreply.github.com>
Subject: [PATCH] win32u: report a consumed input wake as handled

diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
index 336057aa9b..0b5f333793 100644
--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -551,6 +551,7 @@ static BOOL ps5_ProcessEvents( DWORD mask )
     struct ps5_input event;
     HWND hwnd = NtUserGetForegroundWindow();
     UINT processed = 0;
+    BOOL wakeup = FALSE;
 
     if (!next_input) return FALSE;
     if (!hwnd && (hwnd = last_shown_window()))
@@ -571,9 +572,12 @@ static BOOL ps5_ProcessEvents( DWORD mask )
              * would park the UI thread after draining the available bytes. */
             struct pollfd wake = { fd, POLLIN, 0 };
             while (poll( &wake, 1, 0 ) > 0 && (wake.revents & POLLIN))
+            {
                 if (read( fd, buffer, sizeof(buffer) ) <= 0) break;
+                wakeup = TRUE;
+            }
 #else
-            while (read( fd, buffer, sizeof(buffer) ) > 0) {}
+            while (read( fd, buffer, sizeof(buffer) ) > 0) wakeup = TRUE;
 #endif
         }
     }
@@ -602,7 +627,10 @@ static BOOL ps5_ProcessEvents( DWORD mask )
             break;
         }
     }
-    return processed != 0;
+    /* A thread can consume the shared wake pipe after another GUI thread
+     * already took the queued input. Report the wake as handled anyway, so
+     * win32u clears QS_DRIVER and rearms this queue's fd. */
+    return processed != 0 || wakeup;
 }
 
 /***********************************************************************
